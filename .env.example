# CAPTCHA: turnstile is the default when omitted. Set yandex only after the backend supports it.
# Both site keys are public; CAPTCHA server secret keys belong in the backend environment.
VITE_CAPTCHA_PROVIDER=turnstile
VITE_YANDEX_CAPTCHA_SITE_KEY=
