# REQUIRED

VITE_FRONTEND_DOMAIN=localhost

VITE_BACKEND_BASE_URL=http://localhost:4174
VITE_BACKEND_BASE_WS_URL=ws://localhost:4174

VITE_YANDEX_PANO_API_KEY=
VITE_GOOGLE_PANO_API_KEY=
VITE_SEZNAM_PANO_API_KEY=

# OPTIONAL for dev

VITE_AVATARS_BASE_URL=
VITE_STATIC_BASE_URL=

# CAPTCHA: cap (default), yandex, or turnstile. Match the backend's selected verifier.
# The site key is public and belongs to the selected provider; server secrets belong in the backend.
VITE_CAPTCHA_PROVIDER=cap
VITE_CAPTCHA_SITE_KEY=
# Cap public instance URL (enable ENABLE_ASSETS_SERVER, WASM_VERSION=0.0.8) - https://trycap.dev/guide/standalone/options.html#asset-server
# Widget JS is bundled; WASM and optional legacy decompression assets use this server.
VITE_CAPTCHA_VERIFY_URL=
